generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model members {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(100)
  email       String    @unique @db.VarChar(255)
  password    String    @db.VarChar(255)
  phone       String?   @unique @db.VarChar(30)
  role        String?   @default("owner") @db.VarChar(100)
  is_verified Boolean?  @default(false)
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  updated_at  DateTime? @default(now()) @db.Timestamp(6)
  two_factor_enabled Boolean @default(false)
  pending_email      String? @unique @db.VarChar(255)

  store stores?
}

model auth_verification_codes {
  id         Int       @id @default(autoincrement())
  member_id  Int
  email      String    @db.VarChar(255)
  code_hash  String    @db.VarChar(255)
  purpose    String    @db.VarChar(50)
  attempts   Int       @default(0)
  expires_at DateTime  @db.Timestamp(6)
  used_at    DateTime? @db.Timestamp(6)
  created_at DateTime  @default(now()) @db.Timestamp(6)

  @@index([member_id, purpose])
  @@index([expires_at])
}

model stores {
  id         Int       @id @default(autoincrement())
  name       String    @db.VarChar(100)
  email      String?   @db.VarChar(255)
  phone      String?   @db.VarChar(30)
  address    String?   @db.Text
  logo       String?   @db.VarChar(255)
  balance    Decimal   @default(0) @db.Decimal(14, 2)
  owner_id   Int       @unique
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)

  owner          members              @relation(fields: [owner_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "store_owner_id_fkey")
  categories     categories[]
  products       products[]
  transactions   store_transactions[]
  suppliers      suppliers[]
  purchases      purchases[]
  purchase_items purchase_items[]
  expenses       expenses[]
  sales          sales[]
  sale_items     sale_items[]
}

model categories {
  id          Int       @id @default(autoincrement())
  store_id    Int
  name        String    @db.VarChar(100)
  description String?   @db.Text
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  updated_at  DateTime? @default(now()) @db.Timestamp(6)

  store    stores     @relation(fields: [store_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  products products[]

  @@unique([store_id, name])
  @@unique([id, store_id])
}

model products {
  id                  Int       @id @default(autoincrement())
  store_id            Int
  category_id         Int
  supplier_id         Int?
  name                String    @db.VarChar(150)
  sku                 String    @db.VarChar(100)
  description         String?   @db.Text
  purchase_price      Decimal   @default(0) @db.Decimal(12, 2)
  selling_price       Decimal   @default(0) @db.Decimal(12, 2)
  quantity            Int       @default(0)
  low_stock_threshold Int       @default(5)
  created_at          DateTime? @default(now()) @db.Timestamp(6)
  updated_at          DateTime? @default(now()) @db.Timestamp(6)

  store    stores     @relation(fields: [store_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  category categories @relation(fields: [category_id, store_id], references: [id, store_id], onDelete: Restrict, onUpdate: NoAction)
  supplier suppliers? @relation(fields: [supplier_id, store_id], references: [id, store_id], onDelete: Restrict, onUpdate: NoAction)

  purchase_items purchase_items[]
  sale_items     sale_items[]

  @@unique([store_id, sku])
}

model store_transactions {
  id          Int      @id @default(autoincrement())
  store_id    Int
  type        String   @db.VarChar(20)
  amount      Decimal  @db.Decimal(14, 2)
  description String?  @db.VarChar(255)
  created_at  DateTime @default(now()) @db.Timestamp(6)

  store stores @relation(fields: [store_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([store_id, created_at])
}

model suppliers {
  id           Int      @id @default(autoincrement())
  store_id     Int
  name         String   @db.VarChar(150)
  company_name String?  @db.VarChar(150)
  phone        String?  @db.VarChar(30)
  email        String?  @db.VarChar(150)
  address      String?  @db.Text
  notes        String?  @db.Text
  created_at   DateTime @default(now()) @db.Timestamp(6)
  updated_at   DateTime @default(now()) @updatedAt @db.Timestamp(6)

  store     stores      @relation(fields: [store_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  products  products[]
  purchases purchases[]

  @@unique([id, store_id])
  @@index([store_id, name])
}

model purchases {
  id              Int      @id @default(autoincrement())
  store_id        Int
  supplier_id     Int
  purchase_number String   @db.VarChar(50)
  invoice_number  String?  @db.VarChar(100)
  purchase_date   DateTime @default(now()) @db.Date
  total_amount    Decimal  @default(0) @db.Decimal(14, 2)
  paid_amount     Decimal  @default(0) @db.Decimal(14, 2)
  due_amount      Decimal  @default(0) @db.Decimal(14, 2)
  payment_status  String   @default("Unpaid") @db.VarChar(20)
  status          String   @default("Pending") @db.VarChar(20)
  notes           String?  @db.Text
  created_at      DateTime @default(now()) @db.Timestamp(6)
  updated_at      DateTime @updatedAt @db.Timestamp(6)

  store    stores           @relation(fields: [store_id], references: [id], onDelete: Restrict)
  supplier suppliers        @relation(fields: [supplier_id], references: [id], onDelete: Restrict)
  items    purchase_items[]

  @@unique([store_id, purchase_number])
  @@index([store_id, purchase_date])
  @@index([supplier_id])
}

model purchase_items {
  id                      Int      @id @default(autoincrement())
  store_id                Int
  purchase_id             Int
  product_id              Int?
  product_name            String   @db.VarChar(150)
  quantity                Int
  unit_price              Decimal  @db.Decimal(12, 2)
  total_price             Decimal  @db.Decimal(14, 2)
  quantity_added_to_stock Int      @default(0)
  created_at              DateTime @default(now()) @db.Timestamp(6)
  updated_at              DateTime @updatedAt @db.Timestamp(6)

  store    stores    @relation(fields: [store_id], references: [id], onDelete: Restrict)
  purchase purchases @relation(fields: [purchase_id], references: [id], onDelete: Restrict)
  product  products? @relation(fields: [product_id], references: [id], onDelete: Restrict)

  @@index([store_id, purchase_id])
  @@index([product_id])
}

model expenses {
  id             Int      @id @default(autoincrement())
  store_id       Int
  expense_number String   @db.VarChar(50)
  title          String   @db.VarChar(150)
  category       String   @db.VarChar(100)
  amount         Decimal  @db.Decimal(14, 2)
  expense_date   DateTime @db.Date
  payment_method String   @db.VarChar(50)
  status         String   @default("Pending") @db.VarChar(20)
  description    String?  @db.Text
  paid_by        String?  @db.VarChar(150)
  reference      String?  @db.VarChar(100)
  created_at     DateTime @default(now()) @db.Timestamp(6)
  updated_at     DateTime @updatedAt @db.Timestamp(6)

  store stores @relation(fields: [store_id], references: [id], onDelete: Restrict)

  @@unique([store_id, expense_number])
  @@index([store_id, expense_date])
  @@index([store_id, status])
}

model sales {
  id             Int      @id @default(autoincrement())
  store_id       Int
  sale_number    String   @db.VarChar(50)
  customer_name  String   @db.VarChar(150)
  customer_phone String?  @db.VarChar(30)
  sale_date      DateTime @default(now()) @db.Date
  subtotal       Decimal  @default(0) @db.Decimal(14, 2)
  discount       Decimal  @default(0) @db.Decimal(14, 2)
  total_amount   Decimal  @default(0) @db.Decimal(14, 2)
  paid_amount    Decimal  @default(0) @db.Decimal(14, 2)
  due_amount     Decimal  @default(0) @db.Decimal(14, 2)
  payment_method String   @db.VarChar(50)
  payment_status String   @default("Unpaid") @db.VarChar(20)
  status         String   @default("Completed") @db.VarChar(20)
  created_at     DateTime @default(now()) @db.Timestamp(6)
  updated_at     DateTime @updatedAt @db.Timestamp(6)

  store stores       @relation(fields: [store_id], references: [id], onDelete: Restrict)
  items sale_items[]

  @@unique([store_id, sale_number])
  @@index([store_id, sale_date])
  @@index([store_id, payment_status])
}

model sale_items {
  id             Int      @id @default(autoincrement())
  store_id       Int
  sale_id        Int
  product_id     Int?
  product_name   String   @db.VarChar(150)
  quantity       Int
  unit_price     Decimal  @db.Decimal(12, 2)
  purchase_price Decimal  @default(0) @db.Decimal(12, 2)
  total_price    Decimal  @db.Decimal(14, 2)
  created_at     DateTime @default(now()) @db.Timestamp(6)

  store   stores    @relation(fields: [store_id], references: [id], onDelete: Restrict)
  sale    sales     @relation(fields: [sale_id], references: [id], onDelete: Restrict)
  product products? @relation(fields: [product_id], references: [id], onDelete: SetNull)

  @@index([store_id, sale_id])
  @@index([product_id])
}
